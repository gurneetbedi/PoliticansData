# ----------------------------------------------------------------------------
# ECI pipeline — exclude downloaded PDFs and regenerable intermediates.
# Source PDFs are downloaded fresh by scripts/fetch_eci_affidavits.py;
# preprocessed JSONs are regenerated by scripts/preprocess_eci_pdfs.py.
# We DO commit the schema, prompt, example output, and small index files
# under data/eci/for_ai/.
# ----------------------------------------------------------------------------
# Source PDFs (large, downloadable on demand)
data/eci/raw_pdfs/
data/eci/for_ai/pdfs/
data/eci/for_ai/preprocessed/
# per-state OCR outputs (regenerable, 25-50 MB each)
data/eci/for_ai/preprocessed_*/
data/eci/for_ai/output/
data/eci/vision_demo/

# Structured CSVs are regenerable from preprocessed JSONs — keep local only
data/eci/for_ai/extracted/

# Phase 1 test artifacts — sensitive (Akamai session cookies) or temporary
data/eci/_akamai_state.json

# ----------------------------------------------------------------------------
# GPI (Government Performance Index) pipeline data
# All source PDFs and downloaded reports are large and regenerable —
# scripts/gpi_*.py scripts fetch fresh copies on demand. The GPI itself
# ships as scored data in the DB (Postgres in prod, SQLite locally).
# ----------------------------------------------------------------------------

# Source PDFs (big, redownloadable) — RBI Handbook, ASER, NCRB, UDISE, NFHS,
# NHA, NHP, MHA Lok Sabha PDFs, PLFS, BPRD, CAG SFARs & Performance Audits.
data/Statistics on Indian States/
data/aser/*.pdf
data/aser/*/
data/cag/pdfs/
data/cag/catalog/*.csv
data/mha/
data/ncrb/
data/nfhs/*.pdf
data/nfhs/factsheets/
data/nha/*.pdf
data/nhp/*.pdf
data/plfs/*.pdf
data/bprd/
data/udise/*.pdf
data/gpi/rbi/handbook/

# Election Results (used for candidate matching) — regenerable
data/Results/
data/allowlists/

# Direct-PDF LLM outputs (regenerable — very large)
data/eci/for_ai/direct_pdf_extracted/
data/eci/llm_extracted/

# CAG scraped catalog + manifests (JSON + CSV listing all 1,900+ reports)
# ARE kept — small, useful for reproducing downloads
!data/cag/catalog/
!data/cag/catalog/*.json
!data/cag/catalog/*.csv

# Extraction caches (Gemini JSON outputs) ARE kept — small (< 1MB per state)
# and preserves extraction results so runs are cheap to reproduce without
# re-calling Gemini. Covers ASER, CAG SFARs, CAG PAs, NFHS, NHA, NHP, PLFS.
!data/aser/extractions/
!data/aser/extractions/*.json
!data/cag/extractions/
!data/cag/extractions/*.json
!data/cag/pa_extractions/
!data/cag/pa_extractions/*.json
!data/nfhs/extractions/
!data/nfhs/extractions/*.json
!data/nha/extractions/
!data/nha/extractions/*.json
!data/nhp/extractions/
!data/nhp/extractions/*.json
!data/plfs/extractions/
!data/plfs/extractions/*.json

# Sample outputs / small manifests
!data/gpi/samples/

# Reports/CSVs generated by diagnostic scripts — kept if under a MB, else skip
data/reports/gaps_*.csv
data/reports/allowlist_collisions/
data/eci/_phase1_test/

# Wikipedia results scrape cache (regenerable; large HTML files)
data/eci/results/_wiki_*.html
# per-state parsed Wikipedia data (regenerable)
data/eci/results/*_results.json
data/eci/for_ai/llm_extracted/

# LLM cost-tracking sentinel
data/eci/for_ai/_llm_run.log

# Google Cloud service-account credentials — NEVER commit these
**/*-service-account*.json
**/gcp-key*.json
**/lokvani-*-key.json
**/lokvani-vision-key.json
gcp/
.gcp/
# Entire secrets/ folder — anything in here stays local
secrets/
.secrets/

# Fetcher caches / manifests / error pages / debug dumps
data/eci/**/_*.html
data/eci/**/_form_layout.json
data/eci/**/manifest.jsonl
data/eci/dedup_cache.json
data/eci/dedup.json
data/eci/dedup_delhi2025.json
data/eci/reconcile_*.jsonl
data/eci/reconcile_*.summary.json
data/eci/kejriwal_eci_parse.json

# Local per-machine venvs (Playwright + EasyOCR)
.venv-eci/

# Original 5 sample PDFs from the pre-ECI-pivot reconnaissance.
